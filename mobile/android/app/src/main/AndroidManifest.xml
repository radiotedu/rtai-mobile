<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Avatar selection uses the system image picker. Camera and broad storage
         permissions are intentionally absent until an actual capture flow exists. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.POST_PROMOTED_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Firebase Analytics must not merge advertising-id access into this app. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_AD_ID" tools:node="remove" />
    <uses-permission android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION" tools:node="remove" />

    <uses-feature android:name="android.hardware.type.automotive" android:required="false" />
    <uses-feature android:name="android.software.car.templates_host" android:required="false" />

    <application
      android:name=".MainApplication"
      android:label="@string/app_name"
      android:icon="@mipmap/ic_launcher"
      android:roundIcon="@mipmap/ic_launcher_round"
      android:appCategory="audio"
      android:allowBackup="false"
      android:enableOnBackInvokedCallback="false"
      android:networkSecurityConfig="@xml/network_security_config"
      android:theme="@style/AppTheme">
      <meta-data
        android:name="com.google.android.gms.cast.framework.OPTIONS_PROVIDER_CLASS_NAME"
        android:value="com.radiotedumobile.cast.RadioTeduCastOptionsProvider" />
      <!-- No Firebase Analytics data before explicit optional consent. -->
      <meta-data android:name="firebase_analytics_collection_enabled" android:value="false" />
      <meta-data android:name="google_analytics_adid_collection_enabled" android:value="false" />
      <meta-data android:name="google_analytics_default_allow_ad_personalization_signals" android:value="false" />
      <!-- Immutable build/source binding used by release and screenshot audits. -->
      <meta-data android:name="com.radiotedumobile.BUILD_GIT_SHA" android:value="${buildGitSha}" />
      <meta-data android:name="com.radiotedumobile.BUILD_GIT_DIRTY" android:value="${buildGitDirty}" />
      <activity
        android:name=".MainActivity"
        android:label="@string/app_name"
        android:configChanges="keyboard|keyboardHidden|orientation|screenLayout|screenSize|smallestScreenSize|uiMode"
        android:launchMode="singleTask"
        android:windowSoftInputMode="adjustResize"
        android:resizeableActivity="true"
        android:exported="true">
        <intent-filter>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent-filter>

        <intent-filter android:label="Jukebox İsteği">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data android:scheme="radiotedu" android:host="jukebox" />
        </intent-filter>
        <intent-filter android:label="TEDÜ Girişi">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data
                android:scheme="radiotedu"
                android:host="auth"
                android:pathPrefix="/erp/linked" />
        </intent-filter>
        <intent-filter android:autoVerify="true" android:label="Jukebox QR Link">
            <action android:name="android.intent.action.VIEW" />
            <category android:name="android.intent.category.DEFAULT" />
            <category android:name="android.intent.category.BROWSABLE" />
            <data
                android:scheme="https"
                android:host="radiotedu.com"
                android:path="/juke-local/controller" />
            <data
                android:scheme="https"
                android:host="radiotedu.com"
                android:path="/juke-local/controller/" />
        </intent-filter>
      </activity>
      
      <meta-data
        android:name="com.google.android.gms.car.application"
        android:resource="@xml/automotive_app_desc" />
      <!-- Android Auto reads the Google key; native Android Automotive OS
           reads the platform key. A single APK needs both declarations. -->
      <meta-data
        android:name="com.android.automotive"
        android:resource="@xml/automotive_app_desc" />

      <!-- TrackPlayer Music Service — owns the actual audio playback +
           notification/lock-screen MediaSession. RNTP v4 has no media browser,
           so the car browser is RadioTeduCarService (below), not this. -->
      <service
        android:name="com.doublesymmetry.trackplayer.service.MusicService"
        android:exported="true"
        android:stopWithTask="true"
        android:foregroundServiceType="mediaPlayback"
        tools:replace="android:stopWithTask">
        <intent-filter>
          <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent-filter>
      </service>

      <!-- RadioTEDU's single Media3 library/playback service. Android Auto,
           Automotive OS, system media controls, Assistant, and Gemini connect
           to this service. Its driver-safe tree contains Live Radio + Podcasts;
           native ExoPlayer playback works without the React Native runtime. -->
      <service
        android:name=".car.RadioTeduCarService"
        android:exported="true"
        android:foregroundServiceType="mediaPlayback">
        <intent-filter>
          <!-- Media3 controllers use this action. Keep the platform browse
               action alongside it for older Android Auto/AAOS hosts. -->
          <action android:name="androidx.media3.session.MediaLibraryService" />
          <action android:name="android.media.browse.MediaBrowserService" />
          <!-- Assistant and Gemini use the same play-from-search media
               contract. Keep a single owner so queries cannot fall through
               to RNTP's legacy, non-browsable session. -->
          <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
        </intent-filter>
        <!-- Newer AAOS launchers require an explicit service opt-in when the
             single APK also exposes a phone launcher activity. -->
        <meta-data
          android:name="androidx.car.app.launchable"
          android:value="true" />
      </service>

      <receiver
        android:name=".notifications.ListeningReminderReceiver"
        android:exported="false" />
      <receiver
        android:name=".notifications.ReminderBootReceiver"
        android:enabled="true"
        android:exported="false">
        <intent-filter>
          <action android:name="android.intent.action.BOOT_COMPLETED" />
          <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        </intent-filter>
      </receiver>
    </application>
</manifest>
