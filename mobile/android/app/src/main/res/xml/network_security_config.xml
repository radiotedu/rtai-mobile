<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production default: HTTPS only. -->
    <base-config cleartextTrafficPermitted="false" />

    <!-- Listener-only TinyIce port for the six Ogg/FLAC mounts. No account,
         API, voting, WebView, or credential traffic is sent over this rule. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">stream.radiotedu.com</domain>
    </domain-config>

    <!-- Allow cleartext ONLY for local development servers / emulator loopback
         (the dev API at http://127.0.0.1:3000). Never reaches production. -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
