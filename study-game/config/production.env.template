# Public, non-secret deployment coordinates
PUBLIC_ORIGIN=https://radiotedu.com
STUDY_PUBLIC_PATH=/study/
STUDY_ADMIN_PUBLIC_PATH=/study/admin.html
STUDY_API_BASE=/jukebox/api/v1/study
STUDY_ADMIN_API_BASE=/jukebox/api/v1/study/admin

# Secret-manager references only — replace in the server environment, never in browser files
RADIOTEDU_SESSION_SECRET=<secret-manager-reference>
RADIOTEDU_CSRF_SECRET=<secret-manager-reference>
RADIOTEDU_DB_DSN=<secret-manager-reference>
RADIOTEDU_REDIS_URL=<secret-manager-reference-if-used>
STUDY_HEARTBEAT_NONCE_SECRET=<secret-manager-reference>
STUDY_ADMIN_AUDIT_HMAC_KEY=<secret-manager-reference>
RADIOTEDU_STUDY_ADMIN_PRINCIPALS_REF=<protected-role-config-reference>

# Private infrastructure coordinates — obtain from the authorized host inventory
TRUSTED_PROXY_CIDRS=<private-configuration-reference>
STUDY_APP_UPSTREAM=<private-configuration-reference>
STUDY_REALTIME_UPSTREAM=<private-configuration-reference>

# Policy settings (examples; approve against RadioTEDU policy before production)
STUDY_ADMIN_SESSION_MAX_MINUTES=30
STUDY_ADMIN_BAN_RATE_LIMIT_PER_HOUR=30
STUDY_ADMIN_SEARCH_RATE_LIMIT_PER_MINUTE=60
STUDY_ADMIN_AUDIT_RETENTION_DAYS=<approved-retention-period>
