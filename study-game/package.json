{
  "name": "@radiotedu/study-game",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "npm run test:contracts && vitest run",
    "test:contracts": "node scripts/run-contract-tests.mjs",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:evidence": "playwright test e2e/professional-world.spec.ts",
    "stress:players": "npm run build && node scripts/stress-realtime-players.mjs",
    "release:verify": "node scripts/verify-release-bundle.mjs .",
    "release:rar": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/create-release-bundle.ps1",
    "generate:avatar": "node scripts/generate-engine-avatar-assets.mjs",
    "generate:rooms": "node scripts/generate-image-room-data.mjs"
  },
  "dependencies": {
    "lucide": "^1.24.0",
    "phaser": "4.2.1",
    "phaser4-rex-plugins": "4.2.0"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "26.1.1",
    "sharp": "0.35.3",
    "typescript": "7.0.2",
    "vite": "8.1.4",
    "vitest": "4.1.10"
  }
}
